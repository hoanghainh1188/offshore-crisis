[gd_scene format=3]

[node name="MeetingPlaceholder" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.12, 0.12, 0.14, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TimeLabel" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.55, 0.3, 1)
theme_override_font_sizes/font_size = 40
text = "17:00"
horizontal_alignment = 1

[node name="MessageLabel" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.86, 0.83, 0.76, 1)
theme_override_font_sizes/font_size = 14
text = "The meeting with the client has started."
horizontal_alignment = 1

[node name="PlaceholderLabel" type="Label" parent="Center/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.55, 1)
theme_override_font_sizes/font_size = 10
text = "(Placeholder: the 5 PM report comes in a later build.)"
horizontal_alignment = 1
