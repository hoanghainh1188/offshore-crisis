[gd_scene format=3]

[ext_resource type="Script" path="res://run/briefing/briefing_screen.gd" id="1_briefing"]

[sub_resource type="StyleBoxFlat" id="Style_Mail"]
bg_color = Color(0.96, 0.95, 0.92, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
